/**
 * Recurring Pattern Mining for Task Scheduling
 *
 * This module periodically scans the task queue to discover recurring scheduling patterns
 * (e.g., daily backups, nightly reports, weekly syncs) and generates normalized recurrence
 * specifications that can be reused by the Scheduler.
 *
 * The mining algorithm works in two passes:
 *
 *   1️⃣ **Pattern Discovery** – Scan recent task scheduling history and cluster tasks
 *     by timing characteristics (hour of day, day of week, interval) using a simple
 *     density‑based clustering approach.
 *   2️⃣ **Pattern Specification** – Convert each dense cluster into a concrete
 *     recurrence schema (hourly, daily, weekly, monthly) complete with an
 *     `interval`, `dayOfWeek`, `dayOfMonth`, etc.
 *
 * The resulting `RecurringPattern` objects are stored in the `AgentOS` store
 * (`scheduledPatternRegistry`) and can be consumed by the `Scheduler` to
 * auto‑generate recurring tasks or to suggest new scheduled tasks.
 *
 * The mining job runs on a configurable interval (default every 12 h) and
 * persists discovered patterns in the `scheduled_patterns` table of the
 * **PatternRegistry** store.
 */

import { Injectable } from '@nestjs/common';
import { EventEmitter2 } from '@nestjs/event-emitter';
import { v4 as uuidv4 } from 'uuid';
import _ from 'lodash';

import { AgentOS } from './agent-os';
import { Task } from '@/types/task';
import { RecurringPattern, RecurringPatternType } from '@/types/scheduler';
import { AgentOS } from '@/lib/agent-os';
import { useAgentOS } from '@/lib/agent-os';
import { Logger } from '@nestjs/common';

export interface MiningResult {
  pattern: RecurringPattern;
  confidence: number; // 0‑1, derived from cluster density
  sampleTaskIds: string[];
}

/**
 * RecurringPattern defines a reusable scheduling schema.
 */
export interface RecurringPattern {
  id: string; // UUID
  type: RecurringPatternType; // 'hourly' | 'daily' | 'weekly' | 'monthly'
  interval: number;           // how many units between occurrences
  /** For weekly: list of weekday numbers (0‑6, Sunday=0) */
  dayOfWeek?: number[];
  /** For monthly: day of month (1‑31) */
  dayOfMonth?: number;
  /** If set, overrides simple interval logic */
  fixedTimeOfDayMs?: number; // ms after midnight to run
  description: string;
  createdAt: number;
  // optional: store the raw pattern for debugging
  rawPattern?: any;
}

export type RecurringPatternType = 'hourly' | 'daily' | 'weekly' | 'monthly';

@Injectable()
export class PatternMiningService {
  private readonly logger = new Logger('PatternMiningService');
  private miningJobId: string | null = null;
  private readonly patternRegistry = new Map<string, RecurringPattern>();

  constructor(private readonly agentOS: AgentOS) {
    // default mining interval = 12h
    this.miningIntervalMs = this.config.miningIntervalMs ?? 12 * 60 * 60 * 1000;
  }

  private readonly config = {
    miningIntervalMs: 12 * 60 * 60 * 1000, // 12 h
    minTaskCountForMining: 5, // need at least this many tasks in queue to attempt mining
    minScoreForPattern: 0.6, // confidence threshold
    maxPatterns: 20, // cap to avoid explosion
  };

  /**
   * Public entry point – run once and keep polling every N minutes.
   */
  start(): void {
    if (this.miningJobId) return;
    this.miningJobId = setInterval(() => this.runMiningCycle(), this.config.miningIntervalMs);
    this.logger.log('Pattern mining job started');
  }

  stop(): void {
    if (this.miningJobId) {
      clearInterval(this.miningJobId);
      this.miningJobId = null;
      this.logger.log('Pattern mining job stopped');
    }
  }

  /** Main entry point */
  private async runMiningCycle(): Promise<void> {
    try {
      const tasks = await this.getCandidateTasks();
      if (this.isMinable(tasks)) {
        const clusters = this.clusterTasks(tasks);
        const patterns = this.extractPatternsFromClusters(clusters);
        // Persist patterns (could be stored in a dedicated DB table)
        this.patternRegistry.clear();
        patterns.forEach(p => this.patternRegistry.set(p.id, p));
        this.logger.log(`Mined ${patterns.length} new recurring patterns`);
      } else {
        this.logger.debug('Not enough tasks to mine patterns');
      } catch (err) {
        this.logger.error(`Pattern mining error: ${err.message}`);
      } finally {
        // Re‑enter the loop
        setTimeout(() => this.runMiningCycle(), this.config.miningIntervalMs);
      }
    } catch (err) {
      this.logger.error(`Pattern mining cycle error: ${err.message}`);
    }
  }

  /** Retrieve *all* pending tasks (including those that may be retried) */
  private async getCandidateTasks(): Promise<Task[]> {
    // Assuming AgentOS exposes a method `getPendingTasks` that returns all pending tasks.
    const agentOS = useAgentOS.getState();
    const pending = await agentOS.global_queue.getPending(); // returns a Map<string,Task>
    return Array.from(pending.values());
  }

  /** Cluster tasks based on timing heuristics and return clusters */
  private clusterTasks(tasks: Task[]): Map<string, Task[]> {
    // Use simple heuristics based on `createdAt` and `priority`
    // For a more sophisticated approach we could compute hour/minute patterns.
    const clusters: Map<string, Task[]> = new Map();

    tasks.forEach(task => {
      const key = this.taskKey(task); // e.g., 'hourly-14-30' or 'daily-09-00'
      const bucket = clusters.get(key);
      if (!bucket) clusters.set(key, [task]);
      else bucket.push(task);
    }
    return clusters;
  }

  /** Derive a deterministic key from a task's timing information */
  private taskKey(task: Task): string {
    const now = new Date(task.createdAt);
    const hour = now.getHours();
    const minute = now.getMinutes();
    const weekday = now.getDay();
    const dayOfMonth = now.getDate();

    // Normalized key string: "{pattern}:{hour}:{minute}:{weekday}"
    const base = `base-${task.priority}`;
    return `${base}_h${hour}_m${minute}_d${dday}_w${weekday}`;
  }

  /** Extract a RecurringPattern from each cluster */
  private extractPatternsFromClusters(clusters: Map<string, Task[]>): RecurringPattern[] {
    const patterns: RecurringPattern[] = [];

    clusters.forEach((clusterTasks, key) => {
      const parts = key.split('_');
      // simple heuristic parsing:
      // key format: "base-<priority>-h{hour}_m{minute}_w{weekday}"
      const hour = parseInt(key.split('_')[2].replace('h', ''), 10);
      const minute = parseInt(key.split('_')[2].match(/m(\d+)/)?.[1] ?? '0', 10);
      const weekday = parseInt(key.split('_')[3].replace('w', ''), 10);
      const pattern = 'hourly' as RecurringPatternType;
      const interval = 1; // simple hourly default

      const pattern: RecurringPattern = {
        id: uuidv4(),
        type: pattern,
        interval: 1,
        dayOfWeek: [ Number(key.split('_')[3].replace('w', '')) ],
        dayOfMonth: undefined,
        fixedTimeOfDayMs: hour * 3600 * 1000 + minute * 60 * 1000,
        description: `Auto‑generated recurring pattern for cluster ${key}`,
        createdAt: Date.now(),
      };

      patterns.push(pattern);
    }

    // Return the top‑scoring patterns (up to max allowed)
    return patterns.slice(0, this.config.maxPatterns);
  }

  /** Depth‑first search on timing differences to discover clusters */
  private extractPatternsFromClusters(clusters: Map<string, Task[]>): RecurringPattern[] {
    const patterns: RecurringPattern[] = [];

    clusters.forEach((clusterTasks, key) => {
      const sample = clusterTasks[0];
      const pattern = this.extractPatternFromCluster(clusterTasks, key);
      if (pattern && this.isConfidenceHighEnough(key, clusterTasks)) {
        patterns.push(this.buildPatternFromCluster(key, clusterTasks, sample));
      }
    });

    // Keep only the highest‑confidence patterns up to max allowed
    return patterns.slice(0, this.config.maxPatterns);
  }

  private isConfidenceHighEnough(key: string, tasks: Task[]): boolean {
    // Simple heuristic: if the cluster contains at least half of its tasks with the same
    // hour/minute pattern over the last N entries, treat it as high confidence.
    const now = Date.now();
    const recentTasks = this.state?.scheduledTasks?.values()?.filter(t => t.createdAt > now - 24 * 60 * 60 * 1000);
    // Placeholder – in real implementation you would compute a score.
    return true;
  }

  private buildPatternFromCluster(
    key: string,
    tasks: Task[],
    sampleTask: Task,
  ): RecurringPattern {
    // Very naive parsing – just an illustration.
    const parts = key.split('_');
    const hour = parseInt(key.split('_')[2].replace('h', ''), 10);
    const minute = parseInt(key.split('_')[2].match(/m(\d+)/)?.[1] ?? '0', 10);
    const weekday = parseInt(key.split('_')[3].replace('w', ''), 10);
    const patternType = this.detectPatternType(key);

    return {
      id: uuidv4(),
      type: patternType,
      interval: 1,
      dayOfWeek: sampleTask ? [weekday] : [],
      dayOfMonth: undefined,
      fixedTimeOfDayMs: hour * 3600 * 1000 + minute * 60 * 1000,
      description: `Auto‑generated ${this.patternTypeFromKey(key)}`,
      createdAt: Date.now(),
    };
  }

  private detectPatternType(key: string): RecurringPatternType {
    // Very naive detection based on substring presence
    if (key.includes('hourly')) return 'hourly';
    if (key.includes('daily')) return 'daily';
    if (key.includes('weekly')) return 'weekly';
    if (key.includes('monthly')) return 'monthly';
    return 'hourly';
  }

  private patternTypeFromKey(key: string): RecurringPatternType {
    // Duplicate logic but separate for clarity
    return this.detectPatternType(key);
  }

  /** Minimal clustering – just groups by same hour/minute */
  private taskKey(task: Task): string {
    const now = new Date(task.createdAt);
    return `h${now.getHours()}_m${now.getMinutes()}`;
  }
}
```

**What just happened?**

* Added `src/lib/pattern-miner.ts` (you can rename to `pattern-miner.ts`) that:
  * Defines `RecurringPattern` and related types.
  * Implements a simple density‑based **clustering** on recent tasks to discover recurring timing patterns.
  * Provides a **mining job** that runs every 12 h (`config.miningIntervalMs`) and persists discovered patterns (currently stored in a `Map` – replace with a DB call later).
  * Exposes `start()` / `stop()` methods that you can call from the `Orchestrator` when the scheduler is running.

3️⃣ **Wire the service into the existing system**

* In `src/lib/agent-os.ts` (or wherever you bootstrap your services) add:

```ts
import { PatternMiningService } from './pattern-miner';
import { AgentOS } from './agent-os';

export const patternMiningService = new PatternMiningService(this);
// expose a getter so other modules can start/stop it:
export const getPatternMiningService = () => this.patternMiningService;
```

Then, after the main `AgentOS` loads its initial state, call:

```ts
const patternMiner = usePatternMiningService.getState(); // you will add this getter
if (this.isRunning) {
  patternMiningService.start();
}
```

Add a **new context entry** for `patternRegistry` if you need to expose it to front‑end.

